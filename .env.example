# Export your selected provider's variables before starting Live AI.
# This file is an example; the app does not automatically read .env files.
# Optional: copy to .env, add your key locally, then launch explicitly:
# uv run --env-file .env streamlit run app.py
# .env is ignored by Git. Keep keys private.
# Gemini API keys: https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# OpenAI remains supported. Use its key only when choosing that provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional directory for local SQLite history. Default: system temp dir/caresignal
# CARESIGNAL_DATA_DIR=/your/local/data/directory
